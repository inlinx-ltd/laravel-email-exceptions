{
    "name": "inlinx-ltd/laravel-email-exceptions",
    "description": "Email exceptions from your Laravel application with per-exception and global throttling. Fork of abrigham/laravel-email-exceptions, maintained for Laravel 9-13.",
    "license": "MIT",
    "keywords": ["email", "exception", "laravel", "exception-handling", "debugging", "notifications"],
    "authors": [
        {
            "name": "Aaron Brigham",
            "email": "abrigham1@gmail.com"
        },
        {
            "name": "Inlinx Ltd",
            "homepage": "https://github.com/inlinx-ltd"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "suggest": {
        "sentry/sentry-laravel": "Optional fallback when exception emails cannot be sent (SES outage)."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0|^13.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "InlinxLtd\\LaravelEmailExceptions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InlinxLtd\\LaravelEmailExceptions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InlinxLtd\\LaravelEmailExceptions\\EmailExceptionsServiceProvider"
            ]
        }
    }
}
